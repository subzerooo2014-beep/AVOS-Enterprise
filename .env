DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avos"
JWT_SECRET="avos-super-secret"

# =====================================================
# Instagram
# =====================================================
INSTAGRAM_DELIVERY_URL=http://localhost:3000/publisher-engine/mock-delivery/instagram
INSTAGRAM_ACCESS_TOKEN=local-test-token
INSTAGRAM_ACCOUNT_ID=local-instagram-account

# =====================================================
# TikTok
# =====================================================
TIKTOK_DELIVERY_URL=http://localhost:3000/publisher-engine/mock-delivery/tiktok
TIKTOK_ACCESS_TOKEN=local-test-token
TIKTOK_ACCOUNT_ID=local-tiktok-account

# =====================================================
# Google Search / Google Ads
# =====================================================
GOOGLE_SEARCH_DELIVERY_URL=http://localhost:3000/publisher-engine/mock-delivery/google-search
GOOGLE_ADS_ACCESS_TOKEN=local-test-token
GOOGLE_ADS_CUSTOMER_ID=local-google-customer

# =====================================================
# Social Delivery Worker
# =====================================================
SOCIAL_DELIVERY_TIMEOUT_MS=20000
SOCIAL_DELIVERY_POLL_INTERVAL_MS=10000
SOCIAL_DELIVERY_BATCH_SIZE=10
SOCIAL_DELIVERY_MAX_ATTEMPTS=3

INSTAGRAM_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
CONNECTOR_OAUTH_STATE_TTL_MS=600000
CONNECTOR_RATE_LIMIT_WINDOW_MS=60000
CONNECTOR_RATE_LIMIT_MAX=60
PUBLISHER_DELIVERY_MODE=mock
WEBHOOK_SIGNATURE_REQUIRED=false
PUBLISHER_SLA_DELIVERY_TARGET_MS=5000
PUBLISHER_SLA_SUCCESS_RATE_TARGET=99
PUBLISHER_SLA_RECEIPT_COVERAGE_TARGET=90
PUBLISHER_SLA_MAX_AVERAGE_ATTEMPTS=2

AVOS_DIAGNOSTICS_TOKEN=avos-dev-diagnostics
AVOS_SLOW_REQUEST_THRESHOLD_MS=750

AVOS_REQUESTS_PER_MINUTE=1200
AVOS_MAX_CONCURRENT_REQUESTS=100
AVOS_LOAD_SHEDDING_THRESHOLD_PERCENT=90

AVOS_POLICY_ENFORCEMENT_MODE=audit_only
AVOS_POLICY_APPROVAL_TOKEN=avos-dev-policy-approval

AVOS_GOVERNANCE_SIGNING_KEY_ID=avos-governance-key-v1
AVOS_GOVERNANCE_SIGNING_SECRET=avos-dev-governance-signing-secret-change-in-production
