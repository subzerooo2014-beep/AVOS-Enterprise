model PersistentAuditEvent {
  id                 String    @id @default(cuid())
  sequence           Int       @unique
  eventType          String
  severity           String
  action             String
  message            String
  actor              String?
  correlationId      String?
  traceId            String?
  method             String?
  path               String?
  statusCode         Int?
  metadata           Json?
  previousHash       String
  hash               String    @unique
  signature          String?
  signatureAlgorithm String?
  signatureKeyId     String?
  signedAt           DateTime?
  createdAt          DateTime  @default(now())

  @@index([eventType])
  @@index([severity])
  @@index([actor])
  @@index([correlationId])
  @@index([traceId])
  @@index([createdAt])
  @@map("persistent_audit_events")
}

model PersistentRuntimePolicy {
  id                   String                    @id
  name                 String
  description          String
  enabled              Boolean                   @default(true)
  currentVersion       Int                       @default(1)
  currentVersionId     String?                   @unique
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  versions             PersistentPolicyVersion[]
  currentVersionRecord PersistentPolicyVersion?  @relation("CurrentPolicyVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([updatedAt])
  @@map("persistent_runtime_policies")
}

model PersistentPolicyVersion {
  id                   String                   @id @default(cuid())
  policyId             String
  version              Int
  name                 String
  description          String
  enabled              Boolean
  methods              Json
  pathPrefixes         Json
  requireApprovalToken Boolean
  blockInProduction    Boolean
  severity             String
  changeType           String
  changeReason         String?
  changedBy            String?
  correlationId        String?
  traceId              String?
  restoredFromVersion  Int?
  checksum             String
  policySignature      String?
  signatureAlgorithm   String?
  signatureKeyId       String?
  signedAt             DateTime?
  createdAt            DateTime                 @default(now())
  policy               PersistentRuntimePolicy  @relation(fields: [policyId], references: [id], onDelete: Cascade)
  currentForPolicy     PersistentRuntimePolicy? @relation("CurrentPolicyVersion")

  @@unique([policyId, version])
  @@index([policyId])
  @@index([createdAt])
  @@index([changedBy])
  @@index([changeType])
  @@map("persistent_policy_versions")
}

model GovernanceIntegrityScan {
  id                    String   @id @default(cuid())
  status                String
  scope                 String
  auditTotal            Int      @default(0)
  auditVerified         Int      @default(0)
  auditHashValid        Boolean  @default(false)
  auditSignaturesValid  Boolean  @default(false)
  policyTotal           Int      @default(0)
  policyVerified        Int      @default(0)
  policyChecksumsValid  Boolean  @default(false)
  policySignaturesValid Boolean  @default(false)
  unsignedAuditRecords  Int      @default(0)
  unsignedPolicyRecords Int      @default(0)
  compromisedRecordType String?
  compromisedRecordId   String?
  compromisedSequence   Int?
  details               Json?
  executedBy            String?
  correlationId         String?
  traceId               String?
  startedAt             DateTime
  completedAt           DateTime
  createdAt             DateTime @default(now())

  @@index([status])
  @@index([scope])
  @@index([createdAt])
  @@map("governance_integrity_scans")
}

