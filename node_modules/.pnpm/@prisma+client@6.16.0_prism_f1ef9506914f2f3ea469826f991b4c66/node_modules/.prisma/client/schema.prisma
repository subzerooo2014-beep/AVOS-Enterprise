generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branches  Branch[]
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  city           String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Vehicle {
  id                 String              @id @default(cuid())
  vin                String              @unique
  make               String
  model              String
  year               Int
  color              String?
  status             String              @default("AVAILABLE")
  location           String?
  brandId            String?
  vehicleModelId     String?
  trimId             String?
  dealerId           String?
  showroomId         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventory          Inventory?
  maintenanceRecords MaintenanceRecord[]
  serviceRecords     ServiceRecord[]
  testDrives         TestDrive[]
  showroom           Showroom?           @relation(fields: [showroomId], references: [id])
  dealer             Dealer?             @relation(fields: [dealerId], references: [id])
  trim               VehicleTrim?        @relation(fields: [trimId], references: [id])
  vehicleModel       VehicleModel?       @relation(fields: [vehicleModelId], references: [id])
  brand              VehicleBrand?       @relation(fields: [brandId], references: [id])

  @@index([make])
  @@index([model])
  @@index([year])
  @@index([status])
  @@index([location])
  @@index([brandId])
  @@index([vehicleModelId])
  @@index([trimId])
  @@index([dealerId])
  @@index([showroomId])
}

model VehicleBrand {
  id        String         @id @default(cuid())
  name      String         @unique
  country   String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  vehicles  Vehicle[]
  models    VehicleModel[]
}

model VehicleModel {
  id        String        @id @default(cuid())
  brandId   String
  name      String
  bodyType  String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  vehicles  Vehicle[]
  brand     VehicleBrand  @relation(fields: [brandId], references: [id])
  trims     VehicleTrim[]

  @@index([brandId])
}

model VehicleTrim {
  id        String       @id @default(cuid())
  modelId   String
  name      String
  engine    String?
  gearbox   String?
  fuelType  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  vehicles  Vehicle[]
  model     VehicleModel @relation(fields: [modelId], references: [id])

  @@index([modelId])
}

model Inventory {
  id           String          @id @default(cuid())
  vehicleId    String          @unique
  warehouseId  String?
  status       String          @default("AVAILABLE")
  price        Float?
  location     String?
  stockNumber  String?         @unique
  reserved     Boolean         @default(false)
  reservedAt   DateTime?
  receivedAt   DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id])
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  movements    StockMovement[]

  @@index([vehicleId])
  @@index([warehouseId])
  @@index([status])
  @@index([location])
  @@index([reserved])
  @@index([stockNumber])
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contracts    Contract[]
  invoices     Invoice[]
  orders       Order[]
  payments     Payment[]
  quotes       Quote[]
  reservations Reservation[]
  sales        Sale[]
  salesOrders  SalesOrder[]
  testDrives   TestDrive[]

  @@index([email])
  @@index([phone])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  status         SupplierStatus  @default(ACTIVE)
  address        String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  source    String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model Order {
  id         String    @id @default(cuid())
  number     String?   @unique
  status     String    @default("DRAFT")
  total      Float     @default(0)
  notes      String?
  customerId String?
  quoteId    String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  invoice    Invoice?
  quote      Quote?    @relation(fields: [quoteId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
  payments   Payment[]
  sale       Sale?

  @@index([status])
  @@index([customerId])
}

model Payment {
  id         String    @id @default(cuid())
  amount     Float
  method     String?
  reference  String?
  status     String    @default("PENDING")
  paidAt     DateTime?
  notes      String?
  customerId String?
  orderId    String?
  invoiceId  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  order      Order?    @relation(fields: [orderId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([orderId])
  @@index([invoiceId])
}

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  total      Float     @default(0)
  paidAmount Float     @default(0)
  balance    Float     @default(0)
  status     String    @default("UNPAID")
  dueDate    DateTime?
  notes      String?
  customerId String?
  orderId    String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Order?    @relation(fields: [orderId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])
  payments   Payment[]

  @@index([status])
  @@index([customerId])
  @@index([orderId])
}

model Quote {
  id         String    @id @default(cuid())
  number     String?   @unique
  status     String    @default("DRAFT")
  total      Float     @default(0)
  validUntil DateTime?
  notes      String?
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Order?
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([customerId])
}

model Sale {
  id         String    @id @default(cuid())
  number     String?   @unique
  status     String    @default("OPEN")
  total      Float     @default(0)
  soldAt     DateTime?
  notes      String?
  customerId String?
  orderId    String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  order      Order?    @relation(fields: [orderId], references: [id])
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([customerId])
  @@index([orderId])
}

model Contract {
  id         String    @id @default(cuid())
  number     String    @unique
  status     String    @default("DRAFT")
  total      Float     @default(0)
  startDate  DateTime?
  endDate    DateTime?
  notes      String?
  customerId String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([customerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
}

model VehicleCategory {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleFeature {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleOption {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleImage {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleDocument {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleTag {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Dealer {
  id        String     @id @default(cuid())
  name      String?
  code      String?    @unique
  status    String?    @default("ACTIVE")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  address   String?
  email     String?
  phone     String?
  showrooms Showroom[]
  vehicles  Vehicle[]

  @@index([status])
  @@index([code])
}

model Showroom {
  id         String      @id @default(cuid())
  name       String?
  code       String?     @unique
  status     String?     @default("ACTIVE")
  city       String?
  address    String?
  dealerId   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  dealer     Dealer?     @relation(fields: [dealerId], references: [id])
  testDrives TestDrive[]
  vehicles   Vehicle[]

  @@index([status])
  @@index([code])
  @@index([dealerId])
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String
  code        String          @unique
  status      String          @default("ACTIVE")
  location    String?
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  inventories Inventory[]
  movements   StockMovement[]

  @@index([status])
  @@index([code])
  @@index([location])
}

model StockMovement {
  id          String     @id @default(cuid())
  name        String?
  code        String?    @unique
  status      String?    @default("POSTED")
  inventoryId String?
  warehouseId String?
  type        String     @default("ADJUSTMENT")
  quantity    Float      @default(1)
  reference   String?
  reason      String?
  notes       String?
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@index([reference])
}

model Reservation {
  id          String     @id @default(cuid())
  name        String?
  code        String?    @unique
  status      String?    @default("ACTIVE")
  inventoryId String?
  customerId  String?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customer    Customer?  @relation(fields: [customerId], references: [id])
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model TestDrive {
  id          String    @id @default(cuid())
  name        String?
  code        String?   @unique
  status      String?   @default("SCHEDULED")
  vehicleId   String?
  customerId  String?
  showroomId  String?
  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  showroom    Showroom? @relation(fields: [showroomId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([vehicleId])
  @@index([customerId])
  @@index([showroomId])
  @@index([scheduledAt])
}

model InsurancePolicy {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FinanceApplication {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ServiceRecord {
  id          String    @id @default(cuid())
  name        String?
  code        String?   @unique
  status      String?   @default("OPEN")
  vehicleId   String?
  serviceType String?
  odometer    Float?
  cost        Float?
  serviceDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([vehicleId])
  @@index([serviceDate])
}

model MaintenanceRecord {
  id              String    @id @default(cuid())
  name            String?
  code            String?   @unique
  status          String?   @default("OPEN")
  vehicleId       String?
  maintenanceType String?
  odometer        Float?
  cost            Float?
  scheduledAt     DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([status])
  @@index([vehicleId])
  @@index([scheduledAt])
  @@index([completedAt])
}

model OwnershipHistory {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AiMetadata {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  status     PurchaseOrderStatus @default(DRAFT)
  total      Float               @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  items      PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  itemName        String
  quantity        Float
  unitPrice       Float
  total           Float
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id          String           @id @default(cuid())
  customerId  String
  status      String           @default("DRAFT")
  totalAmount Float            @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items       SalesOrderItem[]

  @@index([customerId])
  @@index([status])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Float
  unitPrice    Float
  total        Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([productId])
}

model InventoryTransaction {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String
  type        String
  quantity    Float
  reference   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
}

model AiAgent {
  id          String   @id @default(cuid())
  name        String
  role        String
  status      String   @default("active")
  description String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiEvent {
  id        String   @id @default(cuid())
  type      String
  entity    String?
  entityId  String?
  payload   Json?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model TrustScore {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  score      Int      @default(50)
  riskScore  Int      @default(50)
  reason     String?
  factors    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PartnerCompany {
  id         String   @id @default(cuid())
  name       String
  type       String
  country    String?
  city       String?
  email      String?
  phone      String?
  status     String   @default("pending")
  trustScore Int      @default(50)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExportVehicle {
  id              String   @id @default(cuid())
  vehicleId       String?
  title           String
  condition       String?
  targetCountries Json?
  exportOnly      Boolean  @default(true)
  localSale       Boolean  @default(false)
  shippingReady   Boolean  @default(false)
  documentsReady  Boolean  @default(false)
  aiScore         Int      @default(50)
  demandScore     Int      @default(50)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DealRoom {
  id          String   @id @default(cuid())
  title       String
  vehicleId   String?
  sellerId    String?
  buyerId     String?
  status      String   @default("open")
  dealType    String   @default("standard")
  aiDealScore Int      @default(50)
  riskScore   Int      @default(50)
  commission  Float    @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  reason    String?
  payload   Json?
  createdAt DateTime @default(now())
}

model TrustProfile {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  trustScore      Int      @default(50)
  riskScore       Int      @default(50)
  reputationScore Int      @default(50)
  dealScore       Int      @default(50)
  verified        Boolean  @default(false)
  status          String   @default("active")
  summary         String?
  factors         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReputationSnapshot {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  score      Int      @default(50)
  period     String?
  reason     String?
  metrics    Json?
  createdAt  DateTime @default(now())
}

model RiskAssessment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  riskScore  Int      @default(50)
  level      String   @default("medium")
  reason     String?
  factors    Json?
  createdAt  DateTime @default(now())
}

model TrustRule {
  id          String   @id @default(cuid())
  name        String
  targetType  String
  weight      Int      @default(1)
  enabled     Boolean  @default(true)
  description String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiCampaign {
  id               String   @id @default(cuid())
  title            String
  targetType       String?
  targetId         String?
  campaignType     String   @default("smart")
  status           String   @default("draft")
  goal             String?
  audience         Json?
  channels         Json?
  budget           Float    @default(0)
  expectedReach    Int      @default(0)
  expectedLeads    Int      @default(0)
  performanceScore Int      @default(50)
  aiStrategy       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AiAdCreative {
  id         String   @id @default(cuid())
  campaignId String?
  title      String
  headline   String?
  body       String?
  language   String   @default("ar")
  channel    String?
  format     String   @default("text")
  score      Int      @default(50)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model GrowthOpportunity {
  id              String   @id @default(cuid())
  title           String
  targetType      String?
  targetId        String?
  opportunityType String   @default("marketing")
  priority        String   @default("medium")
  score           Int      @default(50)
  reason          String?
  actions         Json?
  status          String   @default("new")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PublishingPlan {
  id          String    @id @default(cuid())
  campaignId  String?
  channel     String
  country     String?
  language    String    @default("ar")
  scheduledAt DateTime?
  status      String    @default("planned")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DistributionChannel {
  id        String   @id @default(cuid())
  name      String
  type      String
  country   String?
  language  String   @default("ar")
  status    String   @default("active")
  score     Int      @default(50)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublishJob {
  id            String    @id @default(cuid())
  campaignId    String?
  channelId     String?
  title         String
  content       String?
  status        String    @default("queued")
  priority      String    @default("normal")
  scheduledAt   DateTime?
  startedAt     DateTime?
  lockedAt      DateTime?
  lockToken     String?
  workerId      String?
  retryCount    Int       @default(0)
  maxRetries    Int       @default(3)
  lastError     String?
  correlationId String?
  publishedAt   DateTime?
  failedAt      DateTime?
  result        Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([lockedAt])
  @@index([campaignId])
  @@index([channelId])
  @@index([correlationId])
}

model AiActionLog {
  id         String   @id
  entityType String
  entityId   String
  action     String
  status     String   @default("completed")
  createdAt  DateTime @default(now())
}

model AiDecisionHistory {
  id         String   @id
  entityType String
  entityId   String
  decision   Json
  createdAt  DateTime @default(now())
}

model AvosDnaRule {
  id          String   @id
  key         String   @unique
  category    String
  title       String
  description String?
  priority    Int      @default(50)
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model BrainTask {
  id         String   @id
  eventId    String?
  taskType   String
  entityType String?
  entityId   String?
  status     String   @default("queued")
  priority   String   @default("medium")
