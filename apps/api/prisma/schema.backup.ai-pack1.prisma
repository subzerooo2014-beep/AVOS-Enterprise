generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  branches  Branch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id             String       @id @default(cuid())
  name           String
  city           String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Vehicle {
  id       String  @id @default(cuid())
  vin      String  @unique
  make     String
  model    String
  year     Int
  color    String?
  status   String  @default("AVAILABLE")
  location String?

  brandId        String?
  vehicleModelId String?
  trimId         String?
  dealerId       String?
  showroomId     String?

  brand        VehicleBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  vehicleModel VehicleModel? @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  trim         VehicleTrim?  @relation(fields: [trimId], references: [id], onDelete: SetNull)
  dealer       Dealer?       @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  showroom     Showroom?     @relation(fields: [showroomId], references: [id], onDelete: SetNull)

  inventory          Inventory?
  testDrives         TestDrive[]
  serviceRecords     ServiceRecord[]
  maintenanceRecords MaintenanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([make])
  @@index([model])
  @@index([year])
  @@index([status])
  @@index([location])
  @@index([brandId])
  @@index([vehicleModelId])
  @@index([trimId])
  @@index([dealerId])
  @@index([showroomId])
}

model VehicleBrand {
  id       String  @id @default(cuid())
  name     String  @unique
  country  String?
  isActive Boolean @default(true)

  models   VehicleModel[]
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleModel {
  id       String  @id @default(cuid())
  brandId  String
  name     String
  bodyType String?
  isActive Boolean @default(true)

  brand    VehicleBrand  @relation(fields: [brandId], references: [id], onDelete: Restrict)
  trims    VehicleTrim[]
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

model VehicleTrim {
  id       String  @id @default(cuid())
  modelId  String
  name     String
  engine   String?
  gearbox  String?
  fuelType String?

  model    VehicleModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  vehicles Vehicle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([modelId])
}

model Inventory {
  id String @id @default(cuid())

  vehicleId String  @unique
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  status   String  @default("AVAILABLE")
  price    Float?
  location String?

  stockNumber String?   @unique
  reserved    Boolean   @default(false)
  reservedAt  DateTime?
  receivedAt  DateTime?
  notes       String?

  movements    StockMovement[]
  reservations Reservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([warehouseId])
  @@index([status])
  @@index([location])
  @@index([reserved])
  @@index([stockNumber])
}

model Customer {
  id    String  @id @default(cuid())
  name  String
  email String?
  phone String?

  reservations Reservation[]
  testDrives   TestDrive[]
  quotes       Quote[]
  orders       Order[]
  invoices     Invoice[]
  payments     Payment[]
  sales        Sale[]
  contracts    Contract[]
  salesOrders  SalesOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  status         SupplierStatus  @default(ACTIVE)
  address        String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  source    String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([source])
}

model Order {
  id     String  @id @default(cuid())
  number String? @unique
  status String  @default("DRAFT")
  total  Float   @default(0)
  notes  String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  invoice  Invoice?
  payments Payment[]
  sale     Sale?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model Payment {
  id        String    @id @default(cuid())
  amount    Float
  method    String?
  reference String?
  status    String    @default("PENDING")
  paidAt    DateTime?
  notes     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([orderId])
  @@index([invoiceId])
}

model Invoice {
  id         String    @id @default(cuid())
  number     String    @unique
  total      Float     @default(0)
  paidAmount Float     @default(0)
  balance    Float     @default(0)
  status     String    @default("UNPAID")
  dueDate    DateTime?
  notes      String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([orderId])
}

model Quote {
  id         String    @id @default(cuid())
  number     String?   @unique
  status     String    @default("DRAFT")
  total      Float     @default(0)
  validUntil DateTime?
  notes      String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model Sale {
  id     String    @id @default(cuid())
  number String?   @unique
  status String    @default("OPEN")
  total  Float     @default(0)
  soldAt DateTime?
  notes  String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
  @@index([orderId])
}

model Contract {
  id        String    @id @default(cuid())
  number    String    @unique
  status    String    @default("DRAFT")
  total     Float     @default(0)
  startDate DateTime?
  endDate   DateTime?
  notes     String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
}

model VehicleCategory {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleFeature {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleOption {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleImage {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleDocument {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model VehicleTag {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Dealer {
  id        String     @id @default(cuid())
  name      String?
  code      String?    @unique
  status    String?    @default("ACTIVE")
  phone     String?
  email     String?
  address   String?
  vehicles  Vehicle[]
  showrooms Showroom[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([code])
}

model Showroom {
  id         String      @id @default(cuid())
  name       String?
  code       String?     @unique
  status     String?     @default("ACTIVE")
  city       String?
  address    String?
  dealerId   String?
  dealer     Dealer?     @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  vehicles   Vehicle[]
  testDrives TestDrive[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([code])
  @@index([dealerId])
}

model Warehouse {
  id String @id @default(cuid())

  name        String
  code        String  @unique
  status      String  @default("ACTIVE")
  location    String?
  description String?

  inventories Inventory[]
  movements   StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([code])
  @@index([location])
}

model StockMovement {
  id String @id @default(cuid())

  name   String?
  code   String? @unique
  status String? @default("POSTED")

  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  type        String  @default("ADJUSTMENT")
  quantity    Float   @default(1)
  reference   String?
  reason      String?
  notes       String?
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryId])
  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@index([reference])
}

model Reservation {
  id String @id @default(cuid())

  name   String?
  code   String? @unique
  status String? @default("ACTIVE")

  inventoryId String?
  inventory   Inventory? @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  expiresAt DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inventoryId])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
}

model TestDrive {
  id     String  @id @default(cuid())
  name   String?
  code   String? @unique
  status String? @default("SCHEDULED")

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  showroomId String?
  showroom   Showroom? @relation(fields: [showroomId], references: [id], onDelete: SetNull)

  scheduledAt DateTime?
  completedAt DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@index([customerId])
  @@index([showroomId])
  @@index([scheduledAt])
}

model InsurancePolicy {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FinanceApplication {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ServiceRecord {
  id     String  @id @default(cuid())
  name   String?
  code   String? @unique
  status String? @default("OPEN")

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  serviceType String?
  odometer    Float?
  cost        Float?
  serviceDate DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@index([serviceDate])
}

model MaintenanceRecord {
  id     String  @id @default(cuid())
  name   String?
  code   String? @unique
  status String? @default("OPEN")

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  maintenanceType String?
  odometer        Float?
  cost            Float?
  scheduledAt     DateTime?
  completedAt     DateTime?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vehicleId])
  @@index([scheduledAt])
  @@index([completedAt])
}

model OwnershipHistory {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model AiMetadata {
  id        String   @id @default(cuid())
  name      String?
  code      String?  @unique
  status    String?  @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  APPROVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  total      Float               @default(0)
  items      PurchaseOrderItem[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  quantity        Float
  unitPrice       Float
  total           Float
  createdAt       DateTime      @default(now())
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model SalesOrder {
  id          String            @id @default(cuid())
  customerId  String
  customer    Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status      String            @default("DRAFT")
  totalAmount Float             @default(0)

  items       SalesOrderItem[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([customerId])
  @@index([status])
}


model SalesOrderItem {
  id           String      @id @default(cuid())

  salesOrderId String
  salesOrder   SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  productId    String
  quantity     Float
  unitPrice    Float
  total        Float       @default(0)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([salesOrderId])
  @@index([productId])
}


model InventoryTransaction {
  id          String    @id @default(cuid())

  productId   String
  warehouseId String

  type        String
  quantity    Float

  reference   String?
  notes       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([type])
}





model AiAgent {
  id          String   @id @default(cuid())
  name        String
  role        String
  status      String   @default("active")
  description String?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiEvent {
  id        String   @id @default(cuid())
  type      String
  entity    String?
  entityId  String?
  payload   Json?
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model TrustScore {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  score       Int      @default(50)
  riskScore   Int      @default(50)
  reason      String?
  factors     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PartnerCompany {
  id          String   @id @default(cuid())
  name        String
  type        String
  country     String?
  city        String?
  email       String?
  phone       String?
  status      String   @default("pending")
  trustScore  Int      @default(50)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExportVehicle {
  id              String   @id @default(cuid())
  vehicleId       String?
  title           String
  condition       String?
  targetCountries Json?
  exportOnly      Boolean  @default(true)
  localSale       Boolean  @default(false)
  shippingReady   Boolean  @default(false)
  documentsReady  Boolean  @default(false)
  aiScore         Int      @default(50)
  demandScore     Int      @default(50)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DealRoom {
  id          String   @id @default(cuid())
  title       String
  vehicleId   String?
  sellerId    String?
  buyerId     String?
  status      String   @default("open")
  dealType    String   @default("standard")
  aiDealScore Int      @default(50)
  riskScore   Int      @default(50)
  commission  Float    @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  reason    String?
  payload   Json?
  createdAt DateTime @default(now())
}
